{
  "manifest_version": 3,
  "name": "PLG Verify Assistant",
  "version": "0.11.0",
  "description": "Imports individual CAT SIS parts and complete SIS carts into PLG Core.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://sis2.cat.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "PLG Verify Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sis2.cat.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "plg-verify-assistant@partslinkglobal.local",
      "strict_min_version": "121.0"
    }
  }
}