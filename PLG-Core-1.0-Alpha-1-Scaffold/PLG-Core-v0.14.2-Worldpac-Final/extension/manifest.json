{
  "manifest_version": 3,
  "name": "PLG Verify Assistant",
  "version": "0.14.2",
  "description": "Worldpac cart reader with correct subtotal, shipping, and total handling.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://speeddial.worldpac.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://speeddial.worldpac.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "plg-verify-assistant@partslinkglobal.local",
      "strict_min_version": "121.0"
    }
  }
}