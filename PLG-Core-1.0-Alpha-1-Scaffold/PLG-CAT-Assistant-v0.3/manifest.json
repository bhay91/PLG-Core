{
  "manifest_version": 3,
  "name": "PLG CAT Assistant",
  "version": "0.3.0",
  "description": "Connects CAT Parts with the active PartsLink Global job.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://parts.cat.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "PLG CAT Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://parts.cat.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "plg-cat-assistant@partslinkglobal.local",
      "strict_min_version": "121.0"
    }
  }
}