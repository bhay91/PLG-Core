{
  "manifest_version": 3,
  "name": "PLG CAT Assistant",
  "version": "0.2.0",
  "description": "Human-assisted PartsLink Global helper for CAT Parts with OEM terminology expansion.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://parts.cat.com/*"
  ],
  "action": {
    "default_title": "PLG CAT Assistant",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://parts.cat.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "plg-cat-assistant@partslinkglobal.local",
      "strict_min_version": "121.0"
    }
  }
}